#!/bin/bash
set -u
APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPT="$APP_ROOT/Resources/tofu.py"
CANDIDATES=(
  "$HOME/Downloads/Pip_v2/pipenv/bin/python"
  "$HOME/Desktop/Pip_v2/pipenv/bin/python"
  "$HOME/Downloads/pipenv/bin/python"
)
PYTHON=""
for p in "${CANDIDATES[@]}"; do
  if [ -x "$p" ]; then PYTHON="$p"; break; fi
done
if [ -z "$PYTHON" ]; then
  if command -v python3 >/dev/null 2>&1; then PYTHON="$(command -v python3)"; else
    osascript -e 'display alert "Tofu needs Python" message "Python 3 was not found on this Mac." as critical'; exit 1
  fi
fi
unset QT_PLUGIN_PATH
unset QT_QPA_PLATFORM_PLUGIN_PATH
if ! "$PYTHON" -c 'import PyQt6' >/dev/null 2>&1; then
  osascript -e 'display alert "Tofu needs PyQt6" message "I found Python, but not PyQt6. Keep your old Pip_v2/pipenv folder for this lightweight build." as critical'; exit 1
fi
cd "$APP_ROOT/Resources"
exec "$PYTHON" "$SCRIPT"
